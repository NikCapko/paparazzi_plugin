<idea-plugin url="https://www.jetbrains.com/idea">
    <id>com.nikcapko.paparazzi</id>

    <name>Paparazzi</name>

    <vendor email="nik.capko@mail.ru">NikCapko</vendor>

    <version>1.1</version>

    <change-notes><![CDATA[
    <h2>v1.1.0</h2>
    <ul>
        <li><b>New:</b> Точечный запуск выбранных тестов через --tests</li>
        <li><b>New:</b> Контекстное меню с быстрыми действиями</li>
        <li><b>New:</b> Фильтрация "Failed Only" для показа только упавших тестов</li>
        <li><b>New:</b> Счётчики тестов и ошибок на уровне модулей</li>
        <li><b>New:</b> Прогресс-бар при индексации</li>
        <li><b>Improved:</b> Стабильная модель данных — статусы не слетают при изменении строк кода</li>
        <li><b>Improved:</b> Корректное определение статусов через парсинг XML-отчётов</li>
        <li><b>Improved:</b> Убран хардкод варианта сборки</li>
        <li><b>Fixed:</b> Regex для параметризованных тестов</li>
        <li><b>Fixed:</b> Поиск snapshot-файлов</li>
    </ul>
]]></change-notes>

    <idea-version since-build="253.*"/>

    <change-notes>

    </change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool Window — боковая панель -->
        <toolWindow
                id="Paparazzi"
                secondary="false"
                anchor="bottom"
                icon="AllIcons.Actions.Colors"
                factoryClass="com.nikcapko.paparazzi.PaparazziToolWindowFactory"
        />

        <!-- Стартовая активность — первичное сканирование при открытии проекта -->
        <postStartupActivity
                implementation="com.nikcapko.paparazzi.PaparazziStartupActivity"
        />

        <projectConfigurable
                id="paparazzi.settings"
                displayName="Paparazzi"
                parentId="tools"
                instance="com.nikcapko.paparazzi.PaparazziConfigurable"/>

    </extensions>

    <actions>
        <!-- Группа кнопок в тулбаре Tool Window -->
        <group id="Paparazzi.ToolbarActions" text="Paparazzi" popup="false">

            <action
                    id="Paparazzi.RunSelected"
                    class="com.nikcapko.paparazzi.RunSelectedTestAction"
                    text="Run Selected Test"
                    icon="AllIcons.Actions.Execute"
            />

            <action
                    id="Paparazzi.RunAll"
                    class="com.nikcapko.paparazzi.RunAllTestsAction"
                    text="Run All Paparazzi Tests"
                    icon="AllIcons.Actions.RunAll"
            />

            <action
                    id="Paparazzi.ReRecord"
                    class="com.nikcapko.paparazzi.ReRecordAction"
                    text="Re-record Snapshots"
                    icon="AllIcons.Actions.Dump"
            />

            <separator/>

            <action
                    id="Paparazzi.Refresh"
                    class="com.nikcapko.paparazzi.RefreshTestsAction"
                    text="Refresh Test List"
                    icon="AllIcons.Actions.BuildLoadChanges"
            />

            <separator/>

            <action id="Paparazzi.ExpandAll"
                    class="com.nikcapko.paparazzi.ExpandAllTestsAction"
                    text="Expand All"
                    icon="AllIcons.Actions.Expandall"/>

            <action id="Paparazzi.CollapseAll"
                    class="com.nikcapko.paparazzi.CollapseAllTestsAction"
                    text="Collapse All"
                    icon="AllIcons.Actions.Collapseall"/>

        </group>

        <group id="Paparazzi.ContextMenu" text="Paparazzi" popup="true">
            <action
                    id="Paparazzi.RunSelectedCtx"
                    class="com.nikcapko.paparazzi.RunSelectedTestAction"
                    text="Run Test"
                    icon="AllIcons.Actions.Execute"/>

            <action
                    id="Paparazzi.ReRecordCtx"
                    class="com.nikcapko.paparazzi.ReRecordAction"
                    text="Re-record Snapshot"
                    icon="AllIcons.Actions.Refresh"/>

            <separator/>

            <action
                    id="Paparazzi.OpenSourceCtx"
                    class="com.nikcapko.paparazzi.OpenSourceAction"
                    text="Open Source"
                    icon="AllIcons.Actions.EditSource"/>

            <action
                    id="Paparazzi.OpenReferenceCtx"
                    class="com.nikcapko.paparazzi.OpenReferenceSnapshotAction"
                    text="Open Reference Snapshot"
                    icon="AllIcons.Actions.Preview"/>

            <action
                    id="Paparazzi.OpenFailureCtx"
                    class="com.nikcapko.paparazzi.OpenFailureDiffAction"
                    text="Open Failure Diff"
                    icon="AllIcons.Actions.Diff"/>

            <separator/>

            <action
                    id="Paparazzi.CopyGradleCommandCtx"
                    class="com.nikcapko.paparazzi.CopyGradleCommandAction"
                    text="Copy Gradle Command"
                    icon="AllIcons.Actions.Copy"/>

            <action
                    id="Paparazzi.CopyFqnCtx"
                    class="com.nikcapko.paparazzi.CopyTestFqnAction"
                    text="Copy Test FQN"
                    icon="AllIcons.Actions.Copy"/>
        </group>
    </actions>

</idea-plugin>
